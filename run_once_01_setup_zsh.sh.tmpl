#!/bin/bash

# Set zsh as the default shell (prompts for password; skipped if already zsh).
if [ "$(getent passwd "$(id -un)" | cut -d: -f7)" != "$(command -v zsh)" ]; then
  chsh -s "$(command -v zsh)"
fi

# Install or update oh-my-zsh (the official installer pulls if already installed).
# --keep-zshrc: ~/.zshrc is chezmoi-managed, never let the installer touch it.
# RUNZSH=no CHSH=no: don't prompt to launch zsh or change the default shell.
# ZSH= must stay empty, otherwise the exported $ZSH from .zshrc makes the
# installer refuse to update an existing installation.
ZSH= RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --no-chsh --keep-zshrc

CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# Clone a plugin, or pull it if it already exists, so re-runs fetch whatever is new.
sync_plugin() {
  local repo="$1" dir="$2"
  if [ -d "$dir/.git" ]; then
    git -C "$dir" pull --ff-only || echo "warning: could not update $dir"
  else
    git clone --depth=1 "$repo" "$dir"
  fi
}

# Fzf tab plugin
sync_plugin https://github.com/Aloxaf/fzf-tab "$CUSTOM/plugins/fzf-tab"

# zsh-autosuggestions (sourced from the custom plugins dir by ~/.zshrc)
sync_plugin https://github.com/zsh-users/zsh-autosuggestions "$CUSTOM/plugins/zsh-autosuggestions"

# Syntax highlighting
sync_plugin https://github.com/zsh-users/zsh-syntax-highlighting.git "$CUSTOM/plugins/zsh-syntax-highlighting"

# NvChad not installed here: ~/.config/nvim is chezmoi-managed, so the clone would fail.

# pnpm plugin for oh-my-zsh (managed entirely by git, not by chezmoi)
sync_plugin https://github.com/ntnyq/omz-plugin-pnpm.git "$CUSTOM/plugins/pnpm"
