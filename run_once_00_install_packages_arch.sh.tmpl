#!/bin/bash

# Package installer for Arch / Omarchy.
#
# Rules:
#   * Installed means installed. The old check used `command -v <pkg>`, which
#     never matches fonts and other non-executable packages, so those were
#     re-installed on every run. Check the package database by name instead.
#   * If what we want clashes with something the system already provides, stop
#     and ask rather than letting the resolver abort the run. Default is to
#     keep the system package.
#   * Never abort. A package that cannot be installed is recorded and reported
#     at the end, so one bad package does not take down the whole apply.

FAILED=()
SKIPPED=()

have_yay() { command -v yay >/dev/null 2>&1; }

pkg_installed() {
    pacman -Qq "$1" >/dev/null 2>&1 || { have_yay && yay -Qq "$1" >/dev/null 2>&1; }
}

# Installed packages that declare a conflict against the given package name.
# Reads the whole local DB in one pass and matches bare names, ignoring any
# version constraint (foo>=1.0 still blocks foo).
blocks_from_installed() {
    local target=$1
    pacman -Qi 2>/dev/null | awk -v target="$target" '
        {
            i = index($0, " : ")
            if (i == 0) next
            key = substr($0, 1, i - 1)
            val = substr($0, i + 3)
            gsub(/^[ \t]+|[ \t]+$/, "", key)
            gsub(/^[ \t]+|[ \t]+$/, "", val)
        }
        key == "Name" { name = val; next }
        key == "Conflicts With" && val != "None" {
            n = split(val, c, /[ \t]+/)
            for (j = 1; j <= n; j++) {
                split(c[j], v, /[<>=!]+/)
                if (v[1] == target) print name
            }
        }
    ' | sort -u
}

# Installed packages named in the target's own conflict list.
blocks_from_target() {
    local pkg=$1 decl c base
    decl=$(
        { pacman -Si "$pkg" 2>/dev/null; } || \
        { have_yay && yay -Si "$pkg" 2>/dev/null; }
    )
    decl=$(printf '%s\n' "$decl" | awk '
        /^Conflicts With/ {
            sub(/^Conflicts With *: /, "")
            if ($0 != "None") print
        }')
    for c in $decl; do
        base=${c%%[<>=!]*}
        pkg_installed "$base" && printf '%s\n' "$base"
    done | sort -u
}

# Sets CONFLICT_DECISION to "replace" or "keep". Uses a global rather than
# command substitution so the prompt text cannot end up inside the decision.
# With no usable terminal it always keeps the system package.
decide_conflict() {
    local pkg=$1 blockers=$2
    CONFLICT_DECISION="keep"

    # `-r /dev/tty` passes even with no controlling terminal, so probe by
    # actually opening it on a spare fd.
    if ! { exec 3</dev/tty; } 2>/dev/null; then
        echo "   no terminal available - keeping the system package"
        return 0
    fi
    exec 3<&-

    echo ""
    echo "   $pkg clashes with: $blockers"
    echo "   Your system already provides that. Keeping it is usually right."
    local reply
    if read -r -p "   Replace the system package with $pkg? [y/N] " reply </dev/tty 2>/dev/null; then
        if [[ "$reply" =~ ^[Yy] ]]; then
            CONFLICT_DECISION="replace"
        fi
    fi
    return 0
}

install_package() {
    local pkg=$1
    local check=${2:-}

    if pkg_installed "$pkg"; then
        echo "== $pkg already installed"
        return 0
    fi

    if [[ -n "$check" ]] && command -v "$check" >/dev/null 2>&1; then
        echo "== '$check' already on PATH, skipping $pkg"
        return 0
    fi

    local blockers
    blockers=$( { blocks_from_installed "$pkg"; blocks_from_target "$pkg"; } | sort -u | tr '\n' ' ' )
    blockers=${blockers% }

    if [[ -n "$blockers" ]]; then
        decide_conflict "$pkg" "$blockers"
        if [[ "$CONFLICT_DECISION" == "keep" ]]; then
            echo "== keeping $blockers, skipping $pkg"
            SKIPPED+=("$pkg  (kept $blockers)")
            return 0
        fi
        local b
        for b in $blockers; do
            echo "   removing $b"
            if ! sudo pacman -Rns --noconfirm "$b"; then
                echo "!! could not remove $b, leaving $pkg alone"
                FAILED+=("$pkg  (could not remove $b)")
                return 0
            fi
        done
    fi

    echo "== installing $pkg"
    if pacman -Si "$pkg" >/dev/null 2>&1; then
        sudo pacman -S --noconfirm --needed "$pkg" || FAILED+=("$pkg  (pacman)")
    elif have_yay && yay -Si "$pkg" >/dev/null 2>&1; then
        yay -S --noconfirm --needed "$pkg" || FAILED+=("$pkg  (yay)")
    else
        echo "!! $pkg not found in the repos or the AUR"
        FAILED+=("$pkg  (not found)")
    fi
}

if ! command -v pacman >/dev/null 2>&1; then
    echo "Not an Arch system - skipping package install."
    exit 0
fi

echo "Arch Linux detected. Installing packages..."

# Install packages
install_package "npm" "npm"
install_package "fnm" "fnm"
install_package "ttf-jetbrains-mono" ""
install_package "ttf-jetbrains-mono-nerd" ""
install_package "atuin" "atuin"
install_package "zsh" "zsh"
install_package "tig" "tig"
install_package "yazi" "yazi"
install_package "zoxide" "zoxide"
install_package "udiskie" "udiskie"
install_package "neovim" "nvim"
install_package "firefox" "firefox"
install_package "google-chrome" "google-chrome"
install_package "brave-bin" "brave"
install_package "starship" "starship"
install_package "nwg-displays" "nwg-displays"
install_package "7zip" "7z"
install_package "ncdu" "ncdu"
install_package "gum" "gum"
install_package "pandoc" "pandoc"
install_package "aichat" "aichat"

# Terminal & image preview
install_package "alacritty" "alacritty"
install_package "ueberzugpp" "ueberzugpp"

# Install nodejs dependencies using fnm
if command -v fnm >/dev/null 2>&1; then
    echo "Setting up Node.js with fnm..."

    if ! fnm list | grep -q "v22\."; then
        fnm install 22
    else
        echo "Node.js v22 is already installed."
    fi

    fnm default 22
    eval "$(fnm env --shell=bash)"

    if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
        echo "Installing global npm packages..."
        npm install -g pnpm
        npm install -g typescript
        npm install -g vscode-langservers-extracted
        npm install -g typescript-language-server
        echo "Global npm packages installed successfully."
    else
        echo "Warning: Node.js or npm not available after fnm setup"
    fi
else
    echo "Warning: fnm not available, skipping Node.js setup"
fi

echo
echo "Installation script finished."
if [[ ${#SKIPPED[@]} -gt 0 ]]; then
    echo "Skipped (system already provides these):"
    printf '  - %s\n' "${SKIPPED[@]}"
fi
if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo "Could not install:"
    printf '  - %s\n' "${FAILED[@]}"
fi
exit 0
