# Omarchy 3.x (this host) reads ~/.config/hypr/hyprland.conf.
# Omarchy 4 "quattro" (~/vm/omarchy-quattro) ships a Lua config, and Hyprland
# 0.55+ prefers hyprland.lua over hyprland.conf whenever both exist — so the
# .conf overrides are simply never read there. Apply whichever set matches the
# Omarchy installed on this machine; the marker file only exists on quattro.
{{- if stat "/usr/share/omarchy/default/hypr/omarchy.lua" }}
.config/hypr/hyprland.conf
.config/hypr/bindings.conf
.config/hypr/input.conf
.config/hypr/tiling.conf
.config/hypr/autostart.conf
{{- else }}
.config/hypr/hyprland.lua
.config/hypr/bindings.lua
.config/hypr/input.lua
.config/hypr/autostart.lua
{{- end }}
