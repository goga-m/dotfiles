#!/bin/sh

# Managed by chezmoi. The unit file is embedded below as a comment on purpose:
# `run_onchange_*` re-runs when its rendered content changes, so editing
# ~/.config/systemd/user/omarchy-session-autosave.service re-triggers this
# reload/enable/restart instead of leaving systemd on a stale unit.
{{ include "dot_config/systemd/user/omarchy-session-autosave.service" | comment "#" }}

systemctl --user daemon-reload
systemctl --user enable omarchy-session-autosave.service

# Restart right away when a graphical session is already running, so the loop
# picks up the newly installed omarchy-session instead of waiting for next login.
if systemctl --user is-active --quiet graphical-session.target; then
  systemctl --user restart omarchy-session-autosave.service
fi
